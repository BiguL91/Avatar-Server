# ============================================
# Avatar Server - Konfiguration
# ============================================
# Kopiere diese Datei nach backend/.env und passe die Werte an:
#   cp .env.example backend/.env

# --- Allgemein ---
APP_NAME=Avatar Server                          # Name der Anwendung (wird im UI angezeigt)
DEBUG=false                                     # Debug-Modus (true/false) — zeigt detaillierte Fehlermeldungen
BASE_URL=http://localhost:8000                  # Oeffentliche URL des Servers (fuer Avatar-URLs und OIDC-Redirects)

# --- Avatar-Speicherung ---
AVATAR_STORAGE_PATH=./data/avatars              # Verzeichnis fuer Avatar-Dateien
AVATAR_DEFAULT_SIZE=80                          # Standard-Groesse in Pixel wenn keine angegeben
AVATAR_MAX_SIZE=512                             # Maximale Avatar-Groesse in Pixel
AVATAR_SIZES=[32, 64, 80, 128, 256, 512]       # Verfuegbare Groessen fuer die Generierung
AVATAR_UPLOAD_MAX_BYTES=10485760                # Maximale Upload-Groesse in Bytes (10 MB)
AVATAR_ORIGINAL_MAX_PX=1920                     # Maximale Seitenlaenge des Originals in Pixel
AVATAR_CACHE_MAX_AGE=3600                       # Cache-Dauer in Sekunden (1 Stunde)
AVATAR_MAX_UPLOADS=6                            # Maximale Anzahl gespeicherter Avatare pro User

# --- Sprache ---
DEFAULT_LANGUAGE=de                             # Standard-Sprache (de, en)

# --- Datenbank ---
DATABASE_PATH=./data/avatar_server.db           # Pfad zur SQLite-Datenbank

# --- Admin-User (wird beim ersten Start automatisch angelegt) ---
ADMIN_EMAIL=admin@example.com                   # E-Mail des Admin-Users
ADMIN_PASSWORD=changeme                         # Passwort des Admin-Users

# --- Login / Authentifizierung ---
LEGACY_LOGIN=true                               # Login per E-Mail + Passwort erlauben (true/false)
JWT_SECRET=change-me-to-a-random-secret         # Geheimer Schluessel fuer JWT-Tokens (unbedingt aendern!)
JWT_EXPIRE_MINUTES=1440                         # JWT-Token Gueltigkeit in Minuten (1440 = 24 Stunden)

# --- Security ---
TRUSTED_PROXY=                                  # IP/Subnetz des Reverse-Proxy z.B. 192.168.1.10 oder 192.168.1.0/24
ALLOWED_HOSTS=localhost                         # Erlaubte Host-Header, komma-separiert z.B. localhost,avatars.domain.de,192.168.1.50

# --- OIDC / SSO ---
OIDC_ENABLED=false                              # OIDC-Authentifizierung aktivieren (true/false)
OIDC_DISCOVERY_URL=                             # Discovery-URL z.B. https://sso.domain.com/realms/myrealm
OIDC_CLIENT_ID=                                 # Client-ID aus dem Identity Provider
OIDC_CLIENT_SECRET=                             # Client-Secret aus dem Identity Provider
OIDC_CLAIM_EMAIL=email                          # Claim-Name fuer die E-Mail-Adresse
OIDC_CLAIM_NAME=nickname                        # Claim-Name fuer den Anzeigenamen
OIDC_CLAIM_PICTURE=picture                      # Attribut-Name fuer Avatar-URL (WebP)
OIDC_CLAIM_PICTURE_PNG=avatar_png               # Attribut-Name fuer PNG-Avatar-URL
OIDC_CLAIM_GROUPS=groups                        # Claim-Name fuer Gruppen/Rollen
OIDC_ADMIN_GROUP=admin                          # Gruppenname der Admin-Rechte vergibt
OIDC_SYNC_PICTURE=false                         # Avatar-URL an IdP zurueckschreiben (true/false)
OIDC_PICTURE_SIZE=256                           # Groesse in Pixel fuer die Picture-URL

# --- Dev-Modus ---
DEV_MODE=false                                  # Dev-Modus: Login ohne Passwort mit Fake-User (true/false)
DEV_USER_EMAIL=dev@example.com                  # E-Mail des Fake-Users im Dev-Modus
DEV_USER_NAME=Dev User                          # Name des Fake-Users im Dev-Modus
